# ---- Next.js (Vercel) ----
# Public: an toàn khi lộ ra client
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Server-only: KHÔNG bao giờ prefix NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
ADMIN_EMAIL=you@example.com

# ---- Local dev với `supabase start` ----
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# (anon key & service role key local in ra khi chạy `supabase start`)

# ---- Tùy chọn ----
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Chỉ cần nếu self-host Umami, không set thì mặc định dùng Umami Cloud
NEXT_PUBLIC_UMAMI_SRC=

# Sentry: DSN an toàn khi lộ ra client (không phải secret), chỉ dùng khi
# NODE_ENV=production (xem sentry.*.config.ts). SENTRY_ORG/PROJECT/AUTH_TOKEN
# chỉ cần khi muốn upload sourcemap lúc build (CI) — bỏ trống vẫn build được.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ---- Edge Functions: set bằng `supabase secrets set`, KHÔNG để ở đây ----
# FINGERPRINT_SALT=
# ALLOWED_ORIGINS=https://your-domain.com,http://localhost:3000
# RESEND_API_KEY=
# SITE_URL=
