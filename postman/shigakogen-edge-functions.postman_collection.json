    {
      "name": "search",
      "item": [
        {
          "name": "q=hello — có kết quả (200)",
          "request": {
            "method": "GET",
            "header": [{ "key": "apikey", "value": "{{apikey}}" }],
            "url": {
              "raw": "{{base_url}}/search?q=hello&limit=10",
              "host": ["{{base_url}}"],
              "path": ["search"],
              "query": [
                { "key": "q", "value": "hello" },
                { "key": "limit", "value": "10" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('results có hello-world', () => pm.expect(pm.response.json().results.some(r => r.slug === 'hello-world')).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "q quá ngắn — results rỗng, không lỗi (200)",
          "request": {
